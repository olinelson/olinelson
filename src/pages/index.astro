---
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Hero from '../components/sections/hero.astro'
import FeaturedCase from '../components/sections/featuredCase.astro'
import Offers from '../components/sections/offers.astro'
import Flow from '../components/sections/flow.astro'
import Trust from '../components/sections/trust.astro'
import SelectedWork from '../components/sections/selectedWork.astro'
import Personal from '../components/sections/personal.astro'
import BlogsList from '../components/blogsList.astro'
import ContactCta from '../components/sections/contactCta.astro'
import profileImage from '../assets/images/profile.jpg'
import { personSchema, websiteSchema, profilePageSchema, serviceSchema } from '../lib/schema'

const image = `https://olinelson.com${profileImage.src}`
const schema = [personSchema(image), websiteSchema(), profilePageSchema(), serviceSchema()]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Oli Nelson — AI that makes businesses more money"
    description="I build AI that makes businesses more money. Missed calls, slow quotes, admin — I find what's costing you, build the fix, and keep it running. One person. Fixed price. First consult free."
    schema={schema}
  />
  <main>
    <Hero />
    <FeaturedCase />
    <Offers />
    <Flow />
    <Trust />
    <SelectedWork />
    <Personal />
    <BlogsList />
    <ContactCta />
  </main>
</DefaultLayout>
