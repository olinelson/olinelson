---
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Hero from '../components/sections/hero.astro'
import Services from '../components/sections/services.astro'
import Flow from '../components/sections/flow.astro'
import Experience from '../components/sections/experience.astro'
import Personal from '../components/sections/personal.astro'
import BlogsList from '../components/blogsList.astro'
import ContactCta from '../components/sections/contactCta.astro'
import profileImage from '../assets/images/profile.jpg'
import { personSchema, websiteSchema, profilePageSchema, serviceSchema } from '../lib/schema'

const image = `https://olinelson.com${profileImage.src}`
const schema = [personSchema(image), websiteSchema(), profilePageSchema(), serviceSchema()]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Oli Nelson — AI that makes businesses more money"
    description="I use AI to help businesses make more money and save time. Missed calls, slow quotes, admin, follow-ups — I find what's costing you, build the simplest fix, and keep it running. Real products for real businesses, not demos. First consult free."
    schema={schema}
  />
  <main>
    <Hero />
    <Services />
    <Flow />
    <Experience />
    <Personal />
    <BlogsList />
    <ContactCta />
  </main>
</DefaultLayout>
