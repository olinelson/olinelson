---
import { Image } from 'astro:assets'
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Essay from '../components/essay.astro'
import ArrowRight from '../icons/arrowRight.astro'
import BoatPlate from '../components/boatPlate.astro'
import TrackPlate from '../components/trackPlate.astro'
import profileImage from '../assets/images/profile.jpg'
import { profile, home } from '../data/profile'
import { personSchema, websiteSchema, profilePageSchema, serviceSchema } from '../lib/schema'

const image = `https://olinelson.com${profileImage.src}`
const schema = [personSchema(image), websiteSchema(), profilePageSchema(), serviceSchema()]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Oli Nelson — Software for small businesses"
    description="I run a solo software development agency. A one-off fee to get your app live, then keep the lights on or keep building."
    schema={schema}
  />

  <main class="pt-[116px] md:pt-[248px]">
    <h1 class="essay flex items-center gap-[11px] md:gap-[14px]">
      {home.greeting}
      <Image
        src={profileImage}
        alt={profile.name}
        width={80}
        height={80}
        class="size-7 rounded-full object-cover md:size-9"
      />
    </h1>

    <Essay class="mt-10 md:mt-[60px]" essay={home.intro} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.chat} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.kickoff} />

    <div class="mt-10 grid gap-8 md:mt-[62px] md:grid-cols-3 md:gap-6 md:pl-8">
      {
        home.sizes.map((size, i) => (
          <a
            href={profile.enquireUrl}
            data-lead-source={`size-${size.label.toLowerCase()}`}
            class="group flex flex-col"
          >
            <h2 class="text-[17px]/[25.5px] font-semibold">{size.label}</h2>
            <span class="mt-[2px] text-[15px]/[22px] text-muted md:text-base/6">{size.note}</span>
            <BoatPlate months={(i + 1) as 1 | 2 | 3} class="mt-3" />
            <div class="mt-3 flex items-end justify-between">
              <span class="mono price">
                {size.from && <span class="from">from </span>}
                {size.price}
              </span>
              <ArrowRight class="mb-1 size-[15px] opacity-0 transition-opacity group-hover:opacity-60" />
            </div>
          </a>
        ))
      }
    </div>

    <Essay class="mt-11 md:mt-[66px]" essay={home.live} />

    <div class="mt-10 flex flex-col gap-7 md:mt-[62px] md:gap-5 md:pl-8">
      <div
        class="mono flex items-baseline justify-between px-1 pb-1 text-[11px] text-faint md:px-4 md:pb-0 md:text-[13px]"
      >
        <span>{home.speedHeader.left}</span>
        <span>{home.speedHeader.right}</span>
      </div>

      {
        home.speeds.map((speed) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-[14px] gap-y-[2px] md:grid-cols-[232px_minmax(0,1fr)_92px] md:items-center md:gap-x-5 md:px-4">
            <div class="flex items-center gap-[9px] md:col-start-1 md:row-start-1">
              {speed.invert && <span class="lead-dot" />}
              <h2 class="text-[17px]/[25.5px] font-semibold">{speed.label}</h2>
            </div>

            <span class="mono justify-self-end md:col-start-3 md:row-span-2 md:row-start-1 md:self-center md:justify-self-stretch md:text-right">
              {speed.price}
            </span>

            <p class="col-span-2 text-[15px]/[22px] text-muted md:col-span-1 md:col-start-1 md:row-start-2">
              {speed.note}
            </p>

            <TrackPlate
              ships={speed.ships}
              lead={speed.invert}
              class="col-span-2 mt-3 md:col-span-1 md:col-start-2 md:row-span-2 md:row-start-1 md:mt-0 md:self-center"
            />
          </div>
        ))
      }
    </div>

    <Essay class="mt-11 md:mt-[66px]" essay={home.log} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.bugs} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.billing} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.ownership} />
    <Essay class="mt-10 md:mt-[60px]" essay={home.experience} />
    <Essay class="mt-10 md:mt-[60px]" essay={{ lead: home.products.lead }}>
      {
        home.products.items.map((item, i) => (
          <>
            <a href={item.href}>{item.name}</a> {item.gloss}
            {i < home.products.items.length - 1 ? '. ' : '.'}
          </>
        ))
      }
    </Essay>

    <div
      class="mt-14 flex flex-col gap-[18px] md:mt-24 md:flex-row md:items-center md:justify-between md:gap-10"
    >
      <div class="flex flex-col gap-1">
        <h2 class="text-[17px]/[25.5px] font-semibold">{home.close.title}</h2>
        <p class="text-[15px]/[22px] text-muted md:text-base/6">{home.close.body}</p>
      </div>

      <div class="flex shrink-0 items-center gap-[10px]">
        <a
          href={profile.enquireUrl}
          data-lead-source="close"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-[22px] py-[14px] text-[15px] font-medium text-ground transition-opacity hover:opacity-85 md:order-2 md:px-5 md:py-[11px] md:text-sm"
        >
          {home.close.start}
          <ArrowRight class="size-[14px]" />
        </a>
        <a
          href={`tel:${profile.phoneHref}`}
          data-lead-source="close"
          class="pill mono px-[18px] py-[14px] text-[13px] md:order-1 md:py-[11px]"
        >
          {profile.phone}
        </a>
      </div>
    </div>

    <div class="mono mt-14 flex items-center justify-between text-faint md:mt-24">
      <span>{home.footer.name}</span>
      <span class="md:hidden">{home.footer.placeShort}</span>
      <span class="hidden md:inline">{home.footer.place}</span>
    </div>
  </main>
</DefaultLayout>
