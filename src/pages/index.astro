---
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Hero from '../components/sections/hero.astro'
import Flow from '../components/sections/flow.astro'
import Experience from '../components/sections/experience.astro'
import Personal from '../components/sections/personal.astro'
import BlogsList from '../components/blogsList.astro'
import ContactCta from '../components/sections/contactCta.astro'
import profileImage from '../assets/images/profile.jpg'
import { personSchema, websiteSchema, profilePageSchema, serviceSchema } from '../lib/schema'

const image = `https://olinelson.com${profileImage.src}`
const schema = [personSchema(image), websiteSchema(), profilePageSchema(), serviceSchema()]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Oli Nelson — AI consultant & builder"
    description="I'm an AI consultant and builder for small businesses and trades. I find what's slowing your business down, recommend the simplest solution, build it, and keep it running. I've built AI products used by real businesses — not demos. Based in Coffs Harbour on the NSW Mid North Coast, working anywhere. The first consult is free."
    schema={schema}
  />
  <main>
    <Hero />
    <Flow />
    <Experience />
    <Personal />
    <BlogsList />
    <ContactCta />
  </main>
</DefaultLayout>
