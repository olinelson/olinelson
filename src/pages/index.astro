---
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Hero from '../components/sections/hero.astro'
import SelectedWork from '../components/sections/selectedWork.astro'
import Experience from '../components/sections/experience.astro'
import Skills from '../components/sections/skills.astro'
import Personal from '../components/sections/personal.astro'
import BlogsList from '../components/blogsList.astro'
import ContactCta from '../components/sections/contactCta.astro'
import profileImage from '../assets/images/profile.jpg'
import { personSchema, websiteSchema, profilePageSchema } from '../lib/schema'

const image = `https://olinelson.com${profileImage.src}`
const schema = [personSchema(image), websiteSchema(), profilePageSchema()]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Oli Nelson — AI Product Engineer & Founder"
    schema={schema}
  />
  <main>
    <Hero />
    <SelectedWork />
    <Experience />
    <Skills />
    <Personal />
    <BlogsList />
    <ContactCta />
  </main>
</DefaultLayout>
