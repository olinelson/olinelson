---
import DefaultLayout from '../layouts/default.astro'
import Seo from '../components/seo/index.astro'
import Services from '../components/sections/services.astro'
import SelectedWork from '../components/sections/selectedWork.astro'
import Trust from '../components/sections/trust.astro'
import Pricing from '../components/sections/pricing.astro'
import ContactCta from '../components/sections/contactCta.astro'
import { profile } from '../data/profile'
import profileImage from '../assets/images/profile.jpg'
import Mail from '../icons/mail.astro'
import Phone from '../icons/phone.astro'
import { personSchema, serviceSchema, faqSchema, breadcrumbSchema, SITE } from '../lib/schema'

const title = 'Hire Oli Nelson — Custom AI software for small business & trades'
const description =
  'Hire Oli Nelson to build practical, affordable AI software for your small business or trade: missed-call enquiry handling, instant quoting, automated follow-ups, paperwork, and clear reporting. Australia-based, working anywhere. Builds from around $5,000 AUD.'
const canonical = `${SITE}/hire.html`
const image = `${SITE}${profileImage.src}`

const faqs = [
  {
    q: 'What does Oli Nelson do?',
    a: 'I build custom AI software for small businesses and trades — things like answering enquiries after hours, turning a photo or voice note into a quote, chasing follow-ups automatically, generating paperwork and compliance docs, and pulling scattered numbers into one clear picture of how the business is going.',
  },
  {
    q: 'How much does it cost?',
    a: 'A typical build is around $5,000 AUD as a one-off — smaller, focused automations can cost less. After that there’s no monthly fee: bug fixes are free, and the only ongoing cost is the actual running cost (hosting, and any AI usage), passed straight on with no markup. New features or changes are quoted separately, so you only pay for what you actually want. You get a fixed price before any work starts, and the first call is free.',
  },
  {
    q: 'Can’t I just build this myself with AI now?',
    a: 'You can get a demo working in an afternoon — turning that into something real, reliable, and safe is the hard part, and it quietly eats weeks of time you don’t have while you’re running the business. The easy 90% isn’t the problem; it’s the last 10%: the edge cases, the customer data and security, the thing falling over at 5pm on a Friday with a customer on the line. Then it needs maintaining as your business and the underlying tools keep changing. I do this all day, so it’s fast and built to hold up — and I fix anything that breaks for free, so it just keeps working without you ever opening the code.',
  },
  {
    q: 'How is this so much cheaper than custom software used to be?',
    a: 'Two reasons, and neither is cutting corners. First, AI has made building software dramatically faster than it was even a couple of years ago. Second, I’ve built up my own reusable foundations, so I’m never starting from a blank page — the slow, expensive groundwork is already done. The running costs stay low too: I tune the AI to do each job at the lowest cost per task, so there’s no scary bill at the end of the month. That’s how a genuine, custom build lands around $5,000 instead of the $50,000-plus an agency would have quoted a few years ago.',
  },
  {
    q: 'I’ve never bought custom software before — is this risky?',
    a: 'No. You own everything that gets built — the software, the code, the accounts. The price is fixed and agreed up front, there’s no lock-in, and I explain everything in plain English. There’s no monthly fee either — bug fixes are free, and you only ever cover the actual running costs at cost.',
  },
  {
    q: 'Do I need to be technical?',
    a: 'Not at all. Most of my clients run hands-on businesses and have never commissioned software before. I handle the technical side and talk to you in normal language about what it actually does for your business.',
  },
  {
    q: 'What kinds of businesses is this for?',
    a: 'Small and owner-run businesses — including trades like electricians, plumbers, and builders — that used to be too small for custom software to make sense. AI has changed the economics, so a tailored tool is now affordable for you.',
  },
  {
    q: 'Where is Oli based, and can he work with me?',
    a: 'I’m based in Australia and work with businesses anywhere. Most of what I build runs in the cloud, so location is rarely a barrier.',
  },
  {
    q: 'How do we start?',
    a: `Email ${profile.email} or call ${profile.phone} with a sentence or two about what’s eating your time. The first call is free, and I’ll tell you straight whether AI is worth it for you and what it would cost.`,
  },
]

const schema = [
  personSchema(image),
  serviceSchema(),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', item: SITE },
    { name: 'Hire', item: canonical },
  ]),
]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title={title}
    description={description}
    canonical={canonical}
    image={image}
    schema={schema}
  />

  <main>
    <section class="mx-auto max-w-5xl px-6 pt-28 pb-16 sm:pt-32">
      <a
        href="/"
        class="font-mono text-xs tracking-wide text-base-content/55 transition-colors hover:text-primary"
        >← Oli Nelson</a
      >

      <p class="eyebrow mt-10" data-reveal>Work with me</p>

      <h1 class="mt-6 max-w-3xl text-4xl leading-[1.05] sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
        Custom AI software for <span class="text-primary">businesses like yours.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/70 sm:text-xl" data-reveal style="--reveal-delay: 160ms">
        I find where AI can save you hours or win you more work — then I build it, support it,
        and keep making it better. {profile.priceLine}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
        <a
          href={`mailto:${profile.email}?subject=Quick%20chat%20about%20AI%20for%20my%20business`}
          data-lead-source="hire-hero"
          class="btn btn-primary rounded-full px-6 shadow-none"
        >
          <Mail /> Email me
        </a>
        <a
          href={`tel:${profile.phoneHref}`}
          data-lead-source="hire-hero-phone"
          class="btn btn-ghost rounded-full border border-base-300 px-6"
        >
          <Phone /> {profile.phone}
        </a>
      </div>

      <p class="mt-7 flex items-center font-mono text-xs tracking-wide text-base-content/55" data-reveal style="--reveal-delay: 320ms">
        <span class="mr-2 inline-block h-2 w-2 shrink-0 animate-pulse rounded-full bg-success"></span
        >{profile.available}
      </p>
    </section>

    <Services />
    <SelectedWork />
    <Trust />
    <Pricing />

    <section class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
      <header class="max-w-2xl" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-5 text-3xl sm:text-4xl">Common questions.</h2>
      </header>

      <div class="mt-10 flex flex-col gap-3">
        {
          faqs.map((f) => (
            <details class="group rounded-box border border-base-300 bg-base-100 p-6" data-reveal>
              <summary class="cursor-pointer list-none text-lg font-medium marker:hidden">
                {f.q}
              </summary>
              <p class="mt-4 text-base-content/70">{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <ContactCta />
  </main>
</DefaultLayout>
