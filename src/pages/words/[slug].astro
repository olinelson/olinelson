---
import { getCollection, render } from 'astro:content'
import DefaultLayout from '../../layouts/default.astro'
import Seo from '../../components/seo/index.astro'
import { blogPostingSchema, breadcrumbSchema, SITE } from '../../lib/schema'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.public !== false)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, published, preview } = post.data

const dateLabel = published.toLocaleDateString('en-GB', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})
const url = `https://olinelson.com/words/${post.id}.html`
const ogImage = `${SITE}/words/og/${post.id}.png`
const schema = [
  blogPostingSchema(post.data, url, ogImage),
  breadcrumbSchema([
    { name: 'Home', item: SITE },
    { name: 'Words', item: `${SITE}/words.html` },
    { name: title, item: url },
  ]),
]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title={`${title} — Oli Nelson`}
    description={preview}
    canonical={url}
    type="article"
    image={ogImage}
    publishedTime={published.toISOString()}
    schema={schema}
  />

  <main class="mx-auto max-w-3xl px-6 pt-28 pb-24 sm:pt-32">
    <a
      href="/#words"
      class="font-mono text-xs tracking-wide text-base-content/55 transition-colors hover:text-primary"
      >← Words</a
    >

    <header class="mt-8">
      <p class="font-mono text-xs tracking-wide text-base-content/55">{dateLabel}</p>
      <h1 class="mt-3 text-4xl leading-[1.1] sm:text-5xl">{title}</h1>
    </header>

    <article class="prose prose-lg mt-12 max-w-none">
      <Content />
    </article>
  </main>
</DefaultLayout>

<style is:global>
  .prose {
    --tw-prose-body: var(--color-base-content);
    --tw-prose-headings: var(--color-base-content);
    --tw-prose-lead: var(--color-base-content);
    --tw-prose-links: var(--color-primary);
    --tw-prose-bold: var(--color-base-content);
    --tw-prose-counters: var(--color-base-content);
    --tw-prose-bullets: var(--color-base-300);
    --tw-prose-hr: var(--color-base-300);
    --tw-prose-quotes: var(--color-base-content);
    --tw-prose-quote-borders: var(--color-primary);
    --tw-prose-code: var(--color-base-content);
    --tw-prose-th-borders: var(--color-base-300);
    --tw-prose-td-borders: var(--color-base-300);
  }
  .prose :is(h1, h2, h3, h4) {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* Inline code as a tinted pill; strip typography's backtick pseudo-quotes */
  .prose :where(code):not(pre code) {
    font-family: var(--font-mono);
    background: var(--color-base-200);
    border: 1.5px solid var(--color-base-300);
    padding: 0.1em 0.4em;
    border-radius: 0.35em;
    font-size: 0.85em;
    font-weight: 500;
  }
  .prose :where(code):not(pre code)::before,
  .prose :where(code):not(pre code)::after {
    content: none;
  }
  /* Code blocks: Shiki sets its own light bg; frame it like the rest of the UI */
  .prose pre {
    font-family: var(--font-mono);
    border: 1.5px solid var(--color-base-300);
    border-radius: var(--radius-box);
  }
  .prose img {
    border-radius: var(--radius-box);
    border: 1.5px solid var(--color-base-300);
  }
</style>
