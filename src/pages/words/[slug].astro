---
import { getCollection, render } from 'astro:content'
import DefaultLayout from '../../layouts/default.astro'
import Seo from '../../components/seo/index.astro'
import ArrowRight from '../../icons/arrowRight.astro'
import { profile } from '../../data/profile'
import { blogPostingSchema, breadcrumbSchema, SITE } from '../../lib/schema'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.public !== false)
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const { title, published, preview } = post.data

const related = (await getCollection('blog', ({ data }) => data.public !== false))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3)

const dateLabel = published.toLocaleDateString('en-GB', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })
const url = `https://olinelson.com/words/${post.id}.html`
const ogImage = `${SITE}/words/og/${post.id}.png`
const schema = [
  blogPostingSchema(post.data, url, ogImage),
  breadcrumbSchema([
    { name: 'Home', item: SITE },
    { name: 'Words', item: `${SITE}/words.html` },
    { name: title, item: url },
  ]),
]
---

<DefaultLayout>
  <Seo
    slot="seo"
    title={`${title} — Oli Nelson`}
    description={preview}
    canonical={url}
    type="article"
    image={ogImage}
    imageAlt={title}
    publishedTime={published.toISOString()}
    schema={schema}
  />

  <main class="pt-[96px] md:pt-[140px]">
    <header class="max-w-[24ch]">
      <p class="mono text-faint">{dateLabel}</p>
      <h1 class="mt-4 text-[26px]/[34px] font-medium tracking-[-0.005em] md:mt-5 md:text-[38px]/[46px]">
        {title}
      </h1>
    </header>

    <article class="prose mt-11 max-w-[68ch] md:mt-[66px]">
      <Content />
    </article>

    <div
      class="mt-14 flex flex-col gap-[18px] rounded-2xl bg-card px-5 py-[22px] md:mt-24 md:flex-row md:items-center md:justify-between md:gap-10 md:py-[26px] md:pr-7 md:pl-8"
    >
      <div class="flex flex-col gap-1">
        <p class="text-[17px]/[25.5px] font-semibold">{profile.name}</p>
        <p class="text-[15px]/[22px] text-muted md:text-base/6">{profile.available}</p>
      </div>

      <a
        href={profile.enquireUrl}
        data-lead-source="post"
        class="inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-ink px-[22px] py-[14px] text-[15px] font-medium text-ground transition-opacity hover:opacity-85 md:self-auto md:px-5 md:py-[11px] md:text-sm"
      >
        Work with me
        <ArrowRight class="size-[14px]" />
      </a>
    </div>

    {
      related.length > 0 && (
        <nav class="mt-14 md:mt-24" aria-label="More writing">
          <p class="mono text-faint">KEEP READING</p>
          <ul class="mt-4 flex flex-col gap-[10px] md:mt-5 md:gap-3">
            {related.map((r) => (
              <li>
                <a
                  href={`/words/${r.id}.html`}
                  class="tile flex flex-col gap-[6px] rounded-2xl bg-card px-5 py-[18px] md:px-[22px] md:py-5"
                >
                  <span class="mono text-faint">{fmt(r.data.published)}</span>
                  <span class="text-[17px]/[25.5px] font-semibold">{r.data.title}</span>
                  <span class="text-[15px]/[22px] text-muted md:text-base/6">{r.data.preview}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="mono mt-14 flex items-center justify-between text-faint md:mt-24">
      <a href="/words.html" class="transition-colors hover:text-ink">← All writing</a>
      <a href="/" class="transition-colors hover:text-ink">olinelson.com</a>
    </div>
  </main>
</DefaultLayout>

<style is:global>
  .prose {
    --tw-prose-body: var(--color-ink);
    --tw-prose-headings: var(--color-ink);
    --tw-prose-lead: var(--color-muted);
    --tw-prose-links: var(--color-ink);
    --tw-prose-bold: var(--color-ink);
    --tw-prose-counters: var(--color-muted);
    --tw-prose-bullets: var(--color-line);
    --tw-prose-hr: var(--color-line);
    --tw-prose-quotes: var(--color-muted);
    --tw-prose-quote-borders: var(--color-line);
    --tw-prose-captions: var(--color-muted);
    --tw-prose-code: var(--color-ink);
    --tw-prose-pre-bg: var(--color-card);
    --tw-prose-th-borders: var(--color-line);
    --tw-prose-td-borders: var(--color-line);
    font-size: 17px;
    line-height: 30px;
  }
  /* Posts head their sections with `#`, so prose h1 must sit under the page title */
  .prose :is(h1, h2, h3, h4) {
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .prose :is(h1, h2) {
    font-size: 21px;
    line-height: 28px;
  }
  .prose :is(h3, h4) {
    font-size: 18px;
    line-height: 26px;
  }
  @media (width >= 48rem) {
    .prose :is(h1, h2) {
      font-size: 26px;
      line-height: 34px;
    }
    .prose :is(h3, h4) {
      font-size: 20px;
      line-height: 28px;
    }
  }
  .prose :where(a) {
    text-decoration-color: var(--color-dim);
    text-underline-offset: 3px;
  }
  .prose :where(a):hover {
    text-decoration-color: var(--color-ink);
  }
  /* Strip typography's backtick pseudo-quotes around inline code */
  .prose :where(code):not(pre code) {
    font-family: var(--font-mono);
    background: var(--color-card);
    padding: 0.1em 0.4em;
    border-radius: 6px;
    font-size: 0.85em;
    font-weight: 500;
  }
  .prose :where(code):not(pre code)::before,
  .prose :where(code):not(pre code)::after {
    content: none;
  }
  /* Shiki writes its theme background inline on the <pre> */
  .prose pre {
    background: var(--color-card) !important;
    border-radius: 16px;
    padding: 20px 22px;
  }
  .prose img {
    border-radius: 16px;
  }
</style>
