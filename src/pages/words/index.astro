---
import { getCollection } from 'astro:content'
import DefaultLayout from '../../layouts/default.astro'
import Seo from '../../components/seo/index.astro'

const posts = (await getCollection('blog', ({ data }) => data.public !== false)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
)

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Words — Oli Nelson"
    description="Occasional writing by Oli Nelson on software, AI, building products, and music."
    canonical="https://olinelson.com/words.html"
  />

  <main class="pt-[116px] md:pt-[168px]">
    <h1 class="essay">Occasional writing.</h1>

    <ul class="mt-11 flex flex-col gap-[10px] md:mt-[66px] md:gap-3">
      {
        posts.map((p) => (
          <li>
            <a
              href={`/words/${p.id}.html`}
              class="tile flex flex-col gap-[6px] rounded-2xl bg-card px-5 py-[18px] md:px-[22px] md:py-5"
            >
              <span class="mono text-faint">{fmt(p.data.published)}</span>
              <span class="text-[17px]/[25.5px] font-semibold">{p.data.title}</span>
              <span class="text-[15px]/[22px] text-muted md:text-base/6">{p.data.preview}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</DefaultLayout>
