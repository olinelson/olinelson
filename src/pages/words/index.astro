---
import { getCollection } from 'astro:content'
import DefaultLayout from '../../layouts/default.astro'
import Seo from '../../components/seo/index.astro'

const posts = (await getCollection('blog', ({ data }) => data.public !== false)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
)

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Words — Oli Nelson"
    description="Occasional writing by Oli Nelson on software, AI, building products, and music."
    canonical="https://olinelson.com/words.html"
  />

  <main class="mx-auto max-w-3xl px-6 pt-28 pb-24 sm:pt-32">
    <a
      href="/#words"
      class="font-mono text-xs tracking-wide text-base-content/55 transition-colors hover:text-primary"
      >← Home</a
    >

    <header class="mt-8">
      <p class="eyebrow">Words</p>
      <h1 class="mt-5 text-4xl leading-tight sm:text-5xl">Occasional writing.</h1>
    </header>

    <ul class="mt-12 border-t border-base-300">
      {
        posts.map((p) => (
          <li class="group relative border-b border-base-300">
            <div class="grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8">
              <p class="font-mono text-xs tracking-wide text-base-content/55 sm:pt-1">
                {fmt(p.data.published)}
              </p>
              <div>
                <h2 class="text-xl transition-colors group-hover:text-primary">{p.data.title}</h2>
                <p class="mt-1.5 text-sm leading-relaxed text-base-content/65">{p.data.preview}</p>
              </div>
            </div>
            <a class="absolute inset-0" href={`/words/${p.id}.html`} aria-label={p.data.title} />
          </li>
        ))
      }
    </ul>
  </main>
</DefaultLayout>
