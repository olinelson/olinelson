---
import { getCollection } from 'astro:content'
import DefaultLayout from '../../layouts/default.astro'
import Seo from '../../components/seo/index.astro'
import { profile } from '../../data/profile'
import { SITE } from '../../lib/schema'

const items = (await getCollection('work', ({ data }) => data.public !== false)).sort(
  (a, b) => a.data.order - b.data.order || b.data.published.valueOf() - a.data.published.valueOf(),
)
---

<DefaultLayout>
  <Seo
    slot="seo"
    title="Case studies — Oli Nelson, AI Product Engineer"
    description="In-depth case studies of products Oli Nelson has built end-to-end — AI pipelines, 0→1 launches, and full-stack product work."
    canonical={`${SITE}/work.html`}
  />

  <main class="mx-auto max-w-3xl px-6 pt-28 pb-24 sm:pt-32">
    <a
      href="/#work"
      class="font-mono text-xs tracking-wide text-base-content/55 transition-colors hover:text-primary"
      >← Oli Nelson</a
    >

    <header class="mt-8">
      <p class="eyebrow">Case studies</p>
      <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">Things I’ve built, in depth.</h1>
      <p class="mt-5 text-lg text-base-content/70">
        The problem, the approach, and what shipped. {profile.available}
      </p>
    </header>

    <ul class="mt-12 border-t border-base-300">
      {
        items.map((item) => (
          <li class="border-b border-base-300">
            <a
              href={`/work/${item.id}.html`}
              class="group block py-7 transition-colors hover:text-primary"
            >
              <p class="font-mono text-[0.7rem] tracking-wide text-primary uppercase">
                {item.data.tag}
              </p>
              <h2 class="mt-2 text-2xl sm:text-[1.6rem]">{item.data.title}</h2>
              <p class="mt-2 text-base-content/70">{item.data.summary}</p>
              <p class="mt-3 font-mono text-[0.62rem] tracking-wide text-base-content/45">
                {item.data.stack.join(' · ')}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</DefaultLayout>
