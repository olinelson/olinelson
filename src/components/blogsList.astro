---
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog', ({ data }) => data.public !== false)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
)
const latest = posts.slice(0, 5)

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { month: 'short', day: 'numeric', year: 'numeric' })
---

<section id="words" class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <header class="max-w-2xl" data-reveal>
    <p class="eyebrow">Words</p>
    <h2 class="mt-5 text-3xl sm:text-4xl">Occasional writing.</h2>
  </header>

  <ul class="mt-10 border-t border-base-300">
    {
      latest.map((p) => (
        <li class="group relative border-b border-base-300" data-reveal>
          <div class="grid gap-1 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
            <p class="font-mono text-xs tracking-wide text-base-content/55 sm:pt-1">
              {fmt(p.data.published)}
            </p>
            <div>
              <h3 class="text-xl transition-colors group-hover:text-primary">{p.data.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-base-content/65">{p.data.preview}</p>
            </div>
          </div>
          <a class="absolute inset-0" href={`/words/${p.id}.html`} aria-label={p.data.title} />
        </li>
      ))
    }
  </ul>

  {
    posts.length > latest.length && (
      <a
        href="/words.html"
        class="mt-8 inline-flex items-center gap-2 font-mono text-sm text-primary transition-opacity hover:opacity-70"
        data-reveal
      >
        All writing ({posts.length}) →
      </a>
    )
  }
</section>
