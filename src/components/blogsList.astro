---
import { parseFeed } from '@rowanmanning/feed-parser';
const res = await fetch("https://world.hey.com/olivernelson/feed.atom")
const data = await res.text()
const feed = parseFeed(data)

function getPlainTextPreviewSimple(htmlString, maxLength = 150) {
  // Decode HTML entities
  const decodedHtml = htmlString
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'");
  
  // Remove HTML tags and normalize whitespace
  const plainText = decodedHtml
    .replace(/<[^>]+>/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  
  if (plainText.length <= maxLength) return plainText;
  
  const truncated = plainText.substring(0, maxLength);
  const lastSpace = truncated.lastIndexOf(' ');
  
  return lastSpace > maxLength * 0.75 
    ? truncated.substring(0, lastSpace) + '...'
    : truncated + '...';
}

---

<section id="words" class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <header class="max-w-2xl" data-reveal>
    <p class="eyebrow">Words</p>
    <h2 class="mt-5 text-3xl sm:text-4xl">Occasional writing.</h2>
  </header>

  <ul class="mt-10 border-t border-base-300">
    {feed.items.slice(0, 5).map(b =>
    <li class="group relative border-b border-base-300" data-reveal>
      <div class="grid gap-1 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
        <p class="font-mono text-xs tracking-wide text-base-content/55 sm:pt-1">
          {new Date(b.published).toLocaleDateString('en-UK', { month: "short", day: "numeric", year: "numeric"})}
        </p>
        <div>
          <h3 class="text-xl transition-colors group-hover:text-primary">{b.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-base-content/65">{getPlainTextPreviewSimple(b.content)}</p>
        </div>
      </div>
      <a class="absolute inset-0" href={b.url} aria-label={b.title}></a>
    </li>
    )}
  </ul>
</section>
