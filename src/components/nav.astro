---
import { Image } from 'astro:assets'
import { profile } from '../data/profile'
import profileImage from '../assets/images/profile.jpg'
---

<header class="flex items-center justify-between pt-5 md:pt-8">
  <a href="/" class="flex items-center gap-[9px] md:gap-[10px]">
    <Image
      src={profileImage}
      alt={profile.name}
      width={64}
      height={64}
      class="size-6 rounded-full object-cover md:size-[26px]"
    />
    <span class="text-[15px] font-semibold md:text-base">olinelson.com</span>
  </a>

  <nav class="flex items-center gap-5 md:gap-7">
    <a href="/words.html" class="text-sm transition-colors hover:text-muted">Words</a>
    <a href={profile.enquireUrl} data-lead-source="nav" class="pill px-[18px] py-[10px]">
      Contact
    </a>
  </nav>
</header>
