---
import { SEO } from "astro-seo";
import profileImage from '../../assets/images/profile.jpg'

interface Props {
  title?: string
  description?: string
  canonical?: string
  type?: "website" | "article"
  image?: string
  publishedTime?: string
  schema?: object | object[]
}

const defaultDescription = "Product engineer & founder. I ship products end-to-end — discovery, design, full stack, deploy. Open to technical-cofounder, product-engineer, and freelance work."

const defaultImage = `https://olinelson.com${profileImage.src}`

const {
  title = "Oli Nelson",
  description = defaultDescription,
  canonical = "https://olinelson.com",
  type = "website",
  image = defaultImage,
  publishedTime,
  schema,
} = Astro.props

const site = "@o_j_nelson"
const creator = "@o_j_nelson"

const article =
  type === "article" && publishedTime
    ? { publishedTime, authors: ["https://olinelson.com"] }
    : undefined

const graph = schema
  ? {
      "@context": "https://schema.org",
      "@graph": Array.isArray(schema) ? schema : [schema],
    }
  : null
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    basic: {
      title,
      type,
      image,
      url: canonical
    },
    optional: {
      siteName: "Oli Nelson",
      description,
    },
    ...(article ? { article } : {}),
  }}
  twitter={{
    title,
    card: "summary_large_image",
    site,
    creator,
    description,
    image
  }}
/>
{graph && <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />}
