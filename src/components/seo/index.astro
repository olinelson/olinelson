---
import { SEO } from "astro-seo";
import profileImage from '../../assets/images/profile.jpg'

interface Props {
  title?: string
  description?: string
  canonical?: string
  type?: "website" | "article"
}

const defaultDescription = "Product engineer & founder. I ship products end-to-end — discovery, design, full stack, deploy. Open to technical-cofounder, product-engineer, and freelance work."

const {
  title = "Oli Nelson",
  description = defaultDescription,
  canonical = "https://olinelson.com",
  type = "website",
} = Astro.props

const image = `https://olinelson.com${profileImage.src}`
const site = "@o_j_nelson"
const creator = "@o_j_nelson"
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    basic: {
      title,
      type,
      image,
      url: canonical
    }
  }}
  twitter={{
    title,
    card: "summary_large_image",
    site,
    creator,
    description,
    image
  }}
/>
