---
import { SEO } from "astro-seo";

interface Props {
  title?: string
  description?: string
  canonical?: string
  type?: "website" | "article"
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  publishedTime?: string
  schema?: object | object[]
}

const defaultDescription = "I run a solo software development agency. A one-off fee to get your app live, then keep the lights on or keep building. Coffs Harbour, NSW, working anywhere. First call free."

// Branded 1200x630 share card (src/pages/og/home.png.ts).
const defaultImage = "https://olinelson.com/og/home.png"

const {
  title = "Oli Nelson",
  description = defaultDescription,
  canonical = "https://olinelson.com",
  type = "website",
  image = defaultImage,
  imageAlt = "Oli Nelson — Software for small businesses",
  imageWidth = 1200,
  imageHeight = 630,
  publishedTime,
  schema,
} = Astro.props

const site = "@o_j_nelson"
const creator = "@o_j_nelson"

const article =
  type === "article" && publishedTime
    ? { publishedTime, authors: ["https://olinelson.com"] }
    : undefined

const graph = schema
  ? {
      "@context": "https://schema.org",
      "@graph": Array.isArray(schema) ? schema : [schema],
    }
  : null
---

<SEO
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    basic: {
      title,
      type,
      image,
      url: canonical
    },
    optional: {
      siteName: "Oli Nelson",
      description,
    },
    image: {
      url: image,
      width: imageWidth,
      height: imageHeight,
      alt: imageAlt,
    },
    ...(article ? { article } : {}),
  }}
  twitter={{
    title,
    card: "summary_large_image",
    site,
    creator,
    description,
    image,
    imageAlt,
  }}
/>
{graph && <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />}
