---
import { profile, links } from '../../data/profile'
import Mail from '../../icons/mail.astro'
import Phone from '../../icons/phone.astro'
import BrandGithub from '../../icons/brandGithub.astro'
import BrandLinkedin from '../../icons/brandLinkedin.astro'
import BrandX from '../../icons/brandX.astro'
import BrandInstagram from '../../icons/brandInstagram.astro'
import BrandSpotify from '../../icons/brandSpotify.astro'
import Article from '../../icons/article.astro'

const icons = {
  github: BrandGithub,
  linkedin: BrandLinkedin,
  x: BrandX,
  instagram: BrandInstagram,
  spotify: BrandSpotify,
  article: Article,
}
---

<footer id="contact" class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="eyebrow" style="color: var(--color-primary)" data-reveal>Get in touch</p>

    <h2 class="mt-6 max-w-3xl text-4xl leading-[1.08] sm:text-6xl" data-reveal style="--reveal-delay: 80ms">
      Tell me what’s eating your time. <span class="text-primary">I’ll tell you if AI can fix it.</span>
    </h2>

    <p class="mt-6 max-w-xl text-neutral-content/70" data-reveal style="--reveal-delay: 160ms">
      The first call is free and there’s no pitch — just a straight answer on whether
      AI is worth doing here, and what it’d cost.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
      <a
        href={`mailto:${profile.email}?subject=Quick%20chat%20about%20AI%20for%20my%20business`}
        data-lead-source="footer"
        class="btn btn-primary rounded-full px-7 text-base shadow-none"
      >
        <Mail /> {profile.email}
      </a>
      <a
        href={`tel:${profile.phoneHref}`}
        data-lead-source="footer-phone"
        class="btn btn-ghost rounded-full border border-neutral-content/25 px-7 text-base text-neutral-content"
      >
        <Phone /> {profile.phone}
      </a>
    </div>

    <div class="mt-16 flex flex-wrap items-center gap-x-7 gap-y-3 border-t border-neutral-content/15 pt-8" data-reveal>
      {
        links.map((l) => {
          const Icon = icons[l.icon as keyof typeof icons]
          return (
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-mono text-sm text-neutral-content/65 transition-colors hover:text-primary"
            >
              <Icon /> {l.label}
            </a>
          )
        })
      }
    </div>

    <p class="mt-10 font-mono text-xs text-neutral-content/40">
      © {profile.name} · {profile.location}
    </p>
  </div>
</footer>
