---
import { metrics } from '../../data/profile'
---

<section class="bg-base-300">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-px md:grid-cols-4">
    {
      metrics.map((m, i) => (
        <div
          class="bg-base-100 px-6 py-8 sm:py-10"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="font-display text-4xl leading-none text-primary sm:text-5xl">
            {m.value}
          </div>
          <div class="mt-3 font-mono text-[0.7rem] leading-snug tracking-wide text-base-content/60 uppercase">
            {m.label}
          </div>
        </div>
      ))
    }
  </div>
</section>
