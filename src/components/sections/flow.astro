---
import { flow } from '../../data/profile'
---

<section id="what" class="border-y border-base-300 bg-base-100">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow">{flow.eyebrow}</p>
      <h2 class="mt-5 text-3xl sm:text-4xl">{flow.heading}</h2>
      <p class="mt-5 text-base-content/65">{flow.intro}</p>
    </header>

    <ol class="mt-12 flex flex-col gap-4 lg:flex-row lg:items-stretch lg:gap-0">
      {
        flow.steps.map((s, i) => (
          <>
            {i > 0 && (
              <li
                class="flex shrink-0 items-center justify-center font-mono text-2xl text-primary/45 max-lg:rotate-90 lg:px-3"
                aria-hidden="true"
              >
                →
              </li>
            )}
            <li
              class={`flex flex-1 flex-col gap-3 rounded-box border p-6 sm:p-7 ${
                s.free ? 'border-primary/35 bg-primary/[0.07]' : 'border-base-300 bg-base-200'
              }`}
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <div class="flex items-center gap-3">
                <span class="font-display text-4xl text-primary">{s.n}</span>
                <span class="font-display text-2xl leading-none">{s.title}</span>
                {s.free && (
                  <span class="rounded-full bg-primary px-2 py-0.5 font-mono text-[0.58rem] font-medium tracking-wider text-primary-content uppercase">
                    Free
                  </span>
                )}
              </div>
              <p class="text-sm leading-relaxed text-base-content/70">{s.body}</p>
            </li>
          </>
        ))
      }
    </ol>

    <div class="mt-8 rounded-box border border-primary/25 bg-primary/[0.06] p-7 sm:p-9" data-reveal>
      <p class="max-w-3xl font-display text-xl leading-snug sm:text-2xl">
        <span class="text-primary">{flow.closer.lead}</span>{' '}{flow.closer.body}
      </p>
    </div>
  </div>
</section>
