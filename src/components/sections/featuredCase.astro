---
import { featuredCase } from '../../data/profile'
---

<section id="featured-case" class="border-y border-base-300 bg-base-100">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <!-- Narrative & Quote -->
      <div class="space-y-8" data-reveal>
        <div>
          <p class="eyebrow">Case study</p>
          <h2 class="mt-5 font-display text-3xl leading-tight sm:text-4xl">
            {featuredCase.business}
          </h2>
        </div>

        <p class="max-w-2xl text-lg leading-relaxed text-base-content/75">
          {featuredCase.narrative}
        </p>

        <figure class="space-y-4">
          <blockquote
            class={`relative rounded-2xl border p-7 sm:p-8 ${
              featuredCase.quotePending
                ? 'border-base-300 bg-base-200/60'
                : 'border-primary/25 bg-primary/[0.05]'
            }`}
          >
            <svg
              class="mb-3 h-8 w-8 text-primary/35"
              fill="currentColor"
              viewBox="0 0 32 32"
              aria-hidden="true"
            >
              <path
                d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"
              ></path>
            </svg>
            <p
              class={`font-display text-xl leading-snug sm:text-2xl ${
                featuredCase.quotePending ? 'italic text-base-content/55' : 'text-base-content'
              }`}
            >
              {featuredCase.quote}
            </p>
          </blockquote>

          <figcaption class="flex flex-wrap items-center gap-3 pl-2">
            <div class="text-sm">
              <div class="font-medium">{featuredCase.person}</div>
              <div class="text-base-content/60">
                {featuredCase.role}
                {featuredCase.quotePending && (
                  <span class="ml-2 rounded-full border border-base-300 bg-base-200/80 px-2 py-0.5 font-mono text-[0.65rem] text-base-content/50">
                    Quote pending approval
                  </span>
                )}
              </div>
            </div>
          </figcaption>
        </figure>

        <a
          href={`https://${featuredCase.website}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 font-mono text-sm text-primary transition-opacity hover:opacity-70"
        >
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary"></span>
          {featuredCase.website}
        </a>
      </div>

      <!-- Visual: Inspection → Report transformation -->
      <div
        class="relative flex items-center justify-center"
        data-reveal
        style="--reveal-delay: 120ms"
      >
        <div class="relative w-full max-w-md">
          <!-- Before: Scattered inspection photos -->
          <div
            class="absolute left-0 top-0 grid h-48 w-48 grid-cols-3 gap-2 rounded-2xl border border-base-300 bg-base-200/90 p-3 shadow-lg backdrop-blur-sm"
          >
            {
              [1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => (
                <div class="aspect-square rounded-md bg-gradient-to-br from-base-300 to-base-content/20" />
              ))
            }
          </div>

          <!-- Arrow -->
          <div class="absolute left-1/2 top-1/2 z-10 -translate-x-1/2 -translate-y-1/2">
            <svg
              class="h-12 w-12 text-primary drop-shadow-lg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </div>

          <!-- After: Clean report -->
          <div
            class="relative ml-auto mt-24 h-64 w-48 rounded-2xl border border-primary/30 bg-gradient-to-br from-base-100 to-primary/[0.08] p-5 shadow-2xl"
          >
            <!-- Report header -->
            <div class="mb-3 h-12 rounded-lg border border-primary/20 bg-primary/10"></div>
            <!-- Report lines -->
            {
              [1, 2, 3, 4, 5, 6, 7].map((_, i) => (
                <div
                  class="mb-2 h-2 rounded bg-base-content/15"
                  style={`width: ${85 - i * 8}%;`}
                />
              ))
            }
            <!-- Accent line -->
            <div class="mt-4 h-2 w-1/3 rounded bg-primary/40"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
