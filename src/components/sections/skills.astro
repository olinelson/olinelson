---
import { skills } from '../../data/profile'
---

<section class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
  <header class="max-w-2xl" data-reveal>
    <p class="eyebrow">Toolkit</p>
    <h2 class="mt-5 text-3xl sm:text-4xl">What I reach for.</h2>
  </header>

  <dl class="mt-10 grid gap-px overflow-hidden rounded-box border border-base-300 bg-base-300 md:grid-cols-3">
    {
      skills.map((group) => (
        <div class="bg-base-100 p-7" data-reveal>
          <dt class="font-mono text-[0.7rem] tracking-wide text-primary uppercase">
            {group.label}
          </dt>
          <dd class="mt-4 flex flex-wrap gap-2">
            {group.items.split(' · ').map((item) => (
              <span class="rounded-full border border-base-300 px-3 py-1 font-mono text-[0.68rem] text-base-content/65">
                {item}
              </span>
            ))}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
