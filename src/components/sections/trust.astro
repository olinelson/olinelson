---
import { trust } from '../../data/profile'
---

<section id="how-it-works" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <header class="max-w-2xl" data-reveal>
    <p class="eyebrow">No surprises</p>
    <h2 class="mt-5 text-3xl sm:text-4xl">{trust.heading}</h2>
    <p class="mt-5 text-base-content/65">
      Custom software has a bad reputation — expensive, never finished, impossible to
      understand. Here’s how I make sure none of that happens to you.
    </p>
  </header>

  <div class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2">
    {
      trust.items.map((t, i) => (
        <div class="flex gap-5" data-reveal>
          <span class="font-display text-3xl text-base-content/25 sm:text-4xl">0{i + 1}</span>
          <div>
            <h3 class="text-xl">{t.title}</h3>
            <p class="mt-2 text-base-content/70">{t.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
