---
import { Image } from 'astro:assets'
import profileImage from '../../assets/images/profile.jpg'
import { personal, profile } from '../../data/profile'
---

<section id="about" class="border-t border-base-300 bg-base-100">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <div class="grid gap-10 md:grid-cols-[auto_1fr] md:gap-16">
      <div class="md:w-64" data-reveal>
        <div class="relative">
          <div class="absolute -inset-2 rotate-2 rounded-2xl border border-primary/30"></div>
          <div class="relative aspect-[4/5] w-56 overflow-hidden rounded-2xl sm:w-64">
            <!-- PLACEHOLDER: a second, more casual photo would suit the About section. -->
            <Image
              alt={profile.name}
              src={profileImage}
              width={560}
              height={700}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <p class="mt-6 eyebrow">{personal.heading}</p>
      </div>

      <div data-reveal style="--reveal-delay: 100ms">
        <p class="font-display text-2xl leading-snug text-base-content/85 sm:text-[1.7rem]">
          {personal.body}
        </p>

        <div class="mt-10">
          <p class="eyebrow mb-4">Stuff I’ve played on</p>
          <iframe
            title="Recordings Oli has played on"
            src="https://open.spotify.com/embed/playlist/3qDjibCTOF2MiJ7ML51RY0?utm_source=generator"
            width="100%"
            height="152"
            loading="lazy"
            frameborder="0"
            style="border-radius:12px"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          ></iframe>
        </div>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-base-content/55">
          <a class="hover:text-primary" href="https://pianobeachstorybook.com" target="_blank" rel="noopener"
            >↳ Piano Beach — piano + story for kids</a
          >
          <a class="hover:text-primary" href="https://allhandspianoacademy.com" target="_blank" rel="noopener"
            >↳ All Hands Piano Academy</a
          >
        </div>
      </div>
    </div>
  </div>
</section>
