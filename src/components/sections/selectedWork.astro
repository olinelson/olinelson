---
import { Image } from 'astro:assets'
import { work } from '../../data/profile'
import CircleCheck from '../../icons/circle-check.astro'
import ArrowLeft from '../../icons/arrowLeft.astro'
import ricordiShot from '../../assets/images/ricordi-practice-plan.png'
import maestrocastShot from '../../assets/images/maestrocast-annotate.png'

// Real product screenshots, keyed by Project.shot in profile.ts.
const shots = { ricordi: ricordiShot, maestrocast: maestrocastShot }
---

<section id="work" class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <header class="max-w-2xl" data-reveal>
    <p class="eyebrow">Case studies</p>
    <h2 class="mt-5 text-3xl sm:text-4xl">Real problems, shipped.</h2>
    <p class="mt-5 text-base-content/65">
      Software in production, solving actual business problems — the outcome first, the tech second.
      Some built inside companies, some my own products from blank page to paying users.
    </p>
  </header>

  <div class="mt-12 flex flex-col gap-px overflow-hidden rounded-box border border-base-300 bg-base-300">
    {
      work.map((p, i) => (
        <article
          class="group grid gap-6 bg-base-100 p-7 sm:grid-cols-[12rem_1fr] sm:gap-10 sm:p-10"
          data-reveal
        >
          <div class="flex items-baseline gap-4 sm:flex-col sm:gap-2">
            <span class="font-display text-3xl text-base-content/25 sm:text-4xl">
              0{i + 1}
            </span>
            <span class="font-mono text-[0.7rem] tracking-wide text-primary uppercase">
              {p.tag}
            </span>
          </div>

          <div class={p.shot ? 'grid gap-8 lg:grid-cols-[1fr_21rem] lg:items-center' : ''}>
            <div>
              <h3 class="text-2xl sm:text-[1.75rem]">{p.title}</h3>
              <p class="mt-3 max-w-2xl text-base-content/70">{p.blurb}</p>

              <ul class="mt-5 flex flex-col gap-2.5">
                {p.bullets.map((b) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-base-content/80">
                    <span class="mt-0.5 shrink-0 text-primary">
                      <CircleCheck />
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex flex-wrap items-center gap-2">
                {p.stack.map((s) => (
                  <span class="rounded-full border border-base-300 px-3 py-1 font-mono text-[0.68rem] text-base-content/60">
                    {s}
                  </span>
                ))}
              </div>

              {p.href && (
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-primary transition-opacity hover:opacity-70"
                >
                  <span class="rotate-180">
                    <ArrowLeft />
                  </span>
                  {p.hrefLabel}
                </a>
              )}
            </div>

            {p.shot && (
              <figure>
                <Image
                  src={shots[p.shot]}
                  alt={p.shotAlt ?? `${p.title} product screenshot`}
                  widths={[420, 640]}
                  sizes="(min-width: 1024px) 21rem, 100vw"
                  class="h-auto w-full max-w-md rounded-2xl ring-1 ring-base-300/70 shadow-[0_20px_50px_-28px_rgba(40,34,60,0.5)]"
                  loading="lazy"
                />
                <figcaption class="mt-3 font-mono text-[0.68rem] tracking-wide text-base-content/45">
                  {p.hrefLabel} — live
                </figcaption>
              </figure>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
