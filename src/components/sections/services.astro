---
import { services, profile } from '../../data/profile'
---

<section id="what-i-do" class="border-t border-base-300 bg-base-100">
  <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
    <header class="max-w-2xl" data-reveal>
      <p class="eyebrow">{services.heading}</p>
      <h2 class="mt-5 text-3xl sm:text-4xl">{services.title}</h2>
      <p class="mt-5 text-base-content/65">{services.intro}</p>
    </header>

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {
        services.groups.map((group, gi) => (
          <div data-reveal style={`--reveal-delay: ${gi * 80}ms`}>
            <p class="font-mono text-xs tracking-[0.16em] text-primary uppercase">
              {group.label}
            </p>
            <ul class="mt-5 border-t border-base-300">
              {group.items.map((s) => (
                <li class="border-b border-base-300 py-6">
                  <h3 class="text-xl sm:text-2xl">{s.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-base-content/70 sm:text-base">
                    {s.body}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-12 max-w-2xl space-y-3" data-reveal>
      <p class="text-sm text-base-content/55">{services.proof}</p>
      <p class="text-base-content/70">
        {services.closer}{' '}
        <a
          href={profile.enquireUrl}
          data-lead-source="services"
          class="font-medium text-primary underline-offset-4 hover:underline"
        >
          {services.closerCta} →
        </a>
      </p>
    </div>
  </div>
</section>
