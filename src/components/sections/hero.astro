---
import { Image } from 'astro:assets'
import profileImage from '../../assets/images/profile.jpg'
import { profile } from '../../data/profile'
import Mail from '../../icons/mail.astro'
import Phone from '../../icons/phone.astro'
---

<section id="top" class="relative mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28 sm:pb-24">
  <div class="grid items-center gap-10 sm:gap-14 md:grid-cols-[1fr_auto]">
    <div>
      <div class="mb-8 flex items-center gap-4 md:hidden" data-reveal>
        <div class="relative h-14 w-14 shrink-0 overflow-hidden rounded-xl">
          <Image
            alt={profile.name}
            src={profileImage}
            width={120}
            height={120}
            class="h-full w-full object-cover"
          />
        </div>
        <div class="min-w-0">
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-primary">
            {profile.role}
          </p>
          <p class="mt-1 text-sm text-base-content/55">{profile.location}</p>
        </div>
      </div>

      <p class="eyebrow hidden md:inline-flex" data-reveal>
        {profile.role} &nbsp;//&nbsp; {profile.location}
      </p>

      <h1
        class="mt-6 text-4xl leading-[1.05] sm:text-6xl md:text-[4.25rem]"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {profile.headline}<br class="hidden sm:block" />
        <span class="text-primary">{profile.headlineAccent}</span>
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/70 sm:text-xl"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        {profile.subhead}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
        <a
          href={`mailto:${profile.email}?subject=Quick%20chat%20about%20AI%20for%20my%20business`}
          data-lead-source="hero"
          class="btn btn-primary rounded-full px-6 shadow-none"
        >
          <Mail /> Email me
        </a>
        <a
          href={`tel:${profile.phoneHref}`}
          data-lead-source="hero-phone"
          class="btn btn-ghost rounded-full border border-base-300 px-6"
        >
          <Phone /> {profile.phone}
        </a>
      </div>

      <p
        class="mt-7 max-w-xl text-sm leading-relaxed text-base-content/60"
        data-reveal
        style="--reveal-delay: 300ms"
      >
        {profile.priceLine}
      </p>

      <p
        class="mt-5 flex items-center font-mono text-xs tracking-wide text-base-content/55"
        data-reveal
        style="--reveal-delay: 360ms"
      >
        <span class="mr-2 inline-block h-2 w-2 shrink-0 animate-pulse rounded-full bg-success"
        ></span>{profile.available}
      </p>
    </div>

    <div class="relative hidden shrink-0 justify-self-start md:block md:justify-self-end" data-reveal style="--reveal-delay: 120ms">
      <div class="absolute -inset-2 -rotate-3 rounded-2xl border border-primary/40"></div>
      <div class="relative h-32 w-32 overflow-hidden rounded-2xl sm:h-40 sm:w-40">
        <Image
          alt={profile.name}
          src={profileImage}
          width={320}
          height={320}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
