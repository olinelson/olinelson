---
import { Image } from 'astro:assets'
import profileImage from '../../assets/images/profile.jpg'
import { profile } from '../../data/profile'
import Mail from '../../icons/mail.astro'
import Phone from '../../icons/phone.astro'
---

<section id="top" class="relative mx-auto max-w-5xl px-6 pt-16 pb-16 sm:pt-24 sm:pb-24">
  <div class="grid items-center gap-10 md:grid-cols-[1.15fr_1fr] md:gap-14">
    <div class="order-2 md:order-1">
      <div class="flex flex-wrap items-center gap-3" data-reveal>
        <span
          class="inline-flex items-center rounded-full border border-primary/35 bg-primary/[0.08] px-4 py-1.5 font-mono text-xs font-medium tracking-[0.16em] text-primary uppercase"
        >
          {profile.role}
        </span>
        <span class="font-mono text-xs tracking-wide text-base-content/45">{profile.location}</span>
      </div>

      <h1
        class="mt-6 text-4xl leading-[1.08] sm:text-5xl md:text-[3.4rem]"
        data-reveal
        style="--reveal-delay: 80ms"
      >
        {profile.headline}
      </h1>

      <p
        class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/70"
        data-reveal
        style="--reveal-delay: 160ms"
      >
        {profile.subhead}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--reveal-delay: 240ms">
        <a
          href={`mailto:${profile.email}?subject=Free%20consult%20about%20AI%20for%20my%20business`}
          data-lead-source="hero"
          class="btn btn-primary rounded-full px-6 shadow-none"
        >
          <Mail /> Book a free consult
        </a>
        <a
          href={`tel:${profile.phoneHref}`}
          data-lead-source="hero-phone"
          class="btn btn-ghost rounded-full border border-base-300 px-6"
        >
          <Phone /> {profile.phone}
        </a>
      </div>

      <p
        class="mt-6 flex items-center font-mono text-xs tracking-wide text-base-content/55"
        data-reveal
        style="--reveal-delay: 320ms"
      >
        <span class="mr-2 inline-block h-2 w-2 shrink-0 animate-pulse rounded-full bg-success"></span>
        {profile.available}
      </p>
    </div>

    <div class="relative order-1 justify-self-start md:order-2 md:justify-self-end" data-reveal style="--reveal-delay: 120ms">
      <div class="absolute -inset-3 -rotate-2 rounded-3xl border border-primary/35"></div>
      <div class="relative aspect-[4/5] w-52 overflow-hidden rounded-3xl sm:w-64 md:w-72">
        <!-- PLACEHOLDER: swap profile.jpg for a proper hero portrait when you have one. -->
        <Image
          alt={profile.name}
          src={profileImage}
          width={640}
          height={800}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
