---
import { Image } from 'astro:assets'
import { home } from '../data/profile'
import uscreen from '../assets/images/logos/uscreen.svg'
import rapidglobal from '../assets/images/logos/rapidglobal.png'
import nirovision from '../assets/images/logos/nirovision.svg'
import withyouwithme from '../assets/images/logos/withyouwithme.png'
import oculo from '../assets/images/logos/oculo.png'
import ricordi from '../assets/images/logos/ricordi.png'
import maestrocast from '../assets/images/logos/maestrocast.svg'

interface Props {
  class?: string
}

const { class: className } = Astro.props

// Square app icons get rounded corners; wordmarks and line icons sit bare.
const logos = {
  uscreen: { src: uscreen, mark: true },
  rapidglobal: { src: rapidglobal, mark: false },
  nirovision: { src: nirovision, mark: false },
  withyouwithme: { src: withyouwithme, mark: true },
  oculo: { src: oculo, mark: true },
  ricordi: { src: ricordi, mark: true },
  maestrocast: { src: maestrocast, mark: false },
}

const tilt = [-1.2, 0.8, -0.5, 1.1, -0.9, 0.6]
const size = ['text-[19px]/[27px]', 'text-[17px]/[25.5px]', 'text-[17px]/[25.5px]', 'text-[15px]/[22px]', 'text-[19px]/[27px]', 'text-[17px]/[25.5px]']
---

<div class:list={['flex flex-wrap justify-center gap-3 md:gap-x-5 md:gap-y-4 md:px-4', className]}>
  {
    home.experience.places.map((place, i) => {
      const logo = logos[place.logo as keyof typeof logos]
      return (
        <a
          href={place.href}
          class="buoy flex items-center gap-3 rounded-2xl px-5 py-3 md:px-6 md:py-4"
          style={`--tilt: ${tilt[i % tilt.length]}deg; animation-duration: ${(5.6 + i * 0.7).toFixed(1)}s; animation-delay: ${(-i * 1.3).toFixed(1)}s`}
        >
          <Image
            src={logo.src}
            alt=""
            height={56}
            class:list={['h-6 w-auto max-w-[96px] md:h-7', logo.mark && 'rounded-md']}
          />
          <span class:list={['font-semibold', size[i % size.length]]}>{place.name}</span>
        </a>
      )
    })
  }
</div>
