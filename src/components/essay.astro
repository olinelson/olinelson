---
import type { Essay } from '../data/profile'

interface Props {
  essay: Essay
  class?: string
}

const { essay, class: className } = Astro.props
---

<p class:list={['essay', className]}>
  {essay.lead}
  {
    Astro.slots.has('default') ? (
      <Fragment>
        {' '}
        <slot />
      </Fragment>
    ) : (
      essay.rest && ` ${essay.rest}`
    )
  }
</p>
