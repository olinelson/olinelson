---
import Nav from '../components/nav.astro'
import Head from './head.astro'
import WaterField from '../components/waterField.astro'
import IllustrationDefs from '../components/illustrationDefs.astro'
---

<!doctype html>
<html lang="en">
  <slot name="seo" slot="seo" />
  <head>
    <Head />
  </head>
  <body data-controller="leads" data-action="click->leads#track">
    <WaterField />
    <IllustrationDefs />
    <div class="mx-auto flex w-full max-w-[896px] flex-col px-5 pb-[72px] md:pb-[140px]">
      <Nav />
      <slot />
    </div>
  </body>
</html>

<script>
  import '../scripts/application.js'
</script>
